#!/usr/bin/bash
set -o errexit
set -o nounset
set -o pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SOURCE_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -d "${SOURCE_ROOT}/playbooks" && -d "${SOURCE_ROOT}/inventories" ]]; then
    readonly DEFAULT_APP_ROOT="${SOURCE_ROOT}"
    readonly DEFAULT_CONFIG_ROOT="${SOURCE_ROOT}"
    readonly DEFAULT_SETTINGS_FILE="${SOURCE_ROOT}/config/steamroller.yml"
    readonly DEFAULT_REPORT_ROOT="${SOURCE_ROOT}/reports"
    readonly DEFAULT_ANSIBLE_CONFIG="${SOURCE_ROOT}/ansible.cfg"
else
    readonly DEFAULT_APP_ROOT="/opt/steamroller"
    readonly DEFAULT_CONFIG_ROOT="/etc/steamroller"
    readonly DEFAULT_SETTINGS_FILE="/etc/steamroller/steamroller.yml"
    readonly DEFAULT_REPORT_ROOT="/var/lib/steamroller/reports"
    readonly DEFAULT_ANSIBLE_CONFIG="/etc/steamroller/ansible.cfg"
fi

readonly APP_ROOT="${STEAMROLLER_ROOT:-${DEFAULT_APP_ROOT}}"
readonly CONFIG_ROOT="${STEAMROLLER_CONFIG_ROOT:-${DEFAULT_CONFIG_ROOT}}"
readonly SETTINGS_FILE="${STEAMROLLER_SETTINGS_FILE:-${DEFAULT_SETTINGS_FILE}}"
readonly REPORT_ROOT="${STEAMROLLER_REPORT_ROOT:-${DEFAULT_REPORT_ROOT}}"
readonly STEAMROLLER_ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-${DEFAULT_ANSIBLE_CONFIG}}"
readonly SSH_KEY_ROOT="${STEAMROLLER_SSH_KEY_ROOT:-${CONFIG_ROOT}/ssh-keys}"

usage() {
    printf '%s\n' \
        'Usage: steamroller precheck ENVIRONMENT [-q|--quiet] [--repo-off] [-sk|--ssh-key KEY_OR_PROFILE] [ansible-playbook options]' \
        '       steamroller connectivity ENVIRONMENT [-q|--quiet] [-sk|--ssh-key KEY_OR_PROFILE] [ansible-playbook options]' \
        '       steamroller repo-off ENVIRONMENT [-q|--quiet] [-sk|--ssh-key KEY_OR_PROFILE] [ansible-playbook options]' \
        '       steamroller reboot ENVIRONMENT --host HOST [-q|--quiet] [-sk|--ssh-key KEY_OR_PROFILE] [--confirm] [--timeout SECONDS]' \
        '       steamroller update ENVIRONMENT --host HOST [-sk|--ssh-key KEY_OR_PROFILE] [-F|--force] [--preserve-postgresql-unit {backup|restore}]' \
        '       steamroller config [ENVIRONMENT]' \
        '       steamroller inventory {create|add|del|list} [options]' \
        '       steamroller doctor ENVIRONMENT' \
        '       steamroller status' \
        '       steamroller version'
}

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
action="$1"
shift

if [[ "$action" == "version" ]]; then
    tr -d '\n' < "${APP_ROOT}/VERSION"
    printf '\n'
    exit 0
fi

if [[ "$action" == "status" ]]; then
    exec python3 "${APP_ROOT}/scripts/list_reports.py" --report-root "$REPORT_ROOT"
fi

if [[ "$action" == "inventory" ]]; then
    exec python3 "${APP_ROOT}/scripts/manage_inventory.py" \
        --inventory-root "${CONFIG_ROOT}/inventories" "$@"
fi

if [[ "$action" == "config" && $# -eq 0 ]]; then
    set -- dev
fi

[[ "$action" == "precheck" || "$action" == "connectivity" || "$action" == "repo-off" || "$action" == "reboot" || "$action" == "update" || "$action" == "config" || "$action" == "doctor" ]] || {
    usage >&2
    exit 2
}
[[ $# -ge 1 ]] || { usage >&2; exit 2; }

environment="$1"
shift
[[ "$environment" =~ ^[a-zA-Z0-9_-]+$ ]] || {
    printf 'Invalid environment name: %s\n' "$environment" >&2
    exit 2
}

inventory="${CONFIG_ROOT}/inventories/${environment}/hosts.yml"
environment_settings="${CONFIG_ROOT}/inventories/${environment}/steamroller.yml"
[[ -r "$inventory" ]] || {
    printf 'Inventory is not readable: %s\n' "$inventory" >&2
    exit 2
}

settings_options=(--settings "$SETTINGS_FILE")
if [[ -r "$environment_settings" ]]; then
    settings_options+=(--environment-settings "$environment_settings")
fi

python3 "${APP_ROOT}/scripts/validate_config.py" \
    --inventory "$inventory" \
    "${settings_options[@]}" \
    --report-root "$REPORT_ROOT"

if [[ "$action" == "config" ]]; then
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    export ANSIBLE_CONFIG="$STEAMROLLER_ANSIBLE_CONFIG"
    exec python3 "${APP_ROOT}/scripts/show_config.py" \
        --inventory "$inventory" \
        "${settings_options[@]}" \
        --environment "$environment" \
        --report-root "$REPORT_ROOT"
fi

if [[ "$action" == "doctor" ]]; then
    errors=0
    for executable in ansible ansible-playbook ssh; do
        if command -v "$executable" >/dev/null 2>&1; then
            printf 'PASS executable: %s\n' "$executable"
        else
            printf 'FAIL executable not found: %s\n' "$executable" >&2
            errors=$((errors + 1))
        fi
    done
    for readable_file in "$inventory" "$SETTINGS_FILE" "$STEAMROLLER_ANSIBLE_CONFIG"; do
        if [[ -r "$readable_file" ]]; then
            printf 'PASS readable: %s\n' "$readable_file"
        else
            printf 'FAIL not readable: %s\n' "$readable_file" >&2
            errors=$((errors + 1))
        fi
    done
    [[ $errors -eq 0 ]] || exit 1
    ANSIBLE_CONFIG="$STEAMROLLER_ANSIBLE_CONFIG" \
        ansible-inventory -i "$inventory" --list >/dev/null
    printf 'PASS inventory syntax: %s\n' "$inventory"
    exit 0
fi

case "$action" in
    connectivity) playbook="00-connectivity.yml" ;;
    precheck) playbook="10-precheck.yml" ;;
    repo-off) playbook="15-repo-off.yml" ;;
    reboot) playbook="20-reboot.yml" ;;
    update) playbook="" ;;
esac

quiet=false
repo_off_requested=false
reboot_confirmed=false
selected_host=""
reboot_timeout=900
postgresql_unit_mode=""
force_update=false
ssh_key="${STEAMROLLER_SSH_KEY:-}"
ansible_options=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -q|--quiet)
            quiet=true
            shift
            ;;
        --repo-off)
            repo_off_requested=true
            shift
            ;;
        --host)
            [[ $# -ge 2 ]] || {
                printf '%s\n' 'Missing inventory hostname after --host.' >&2
                exit 2
            }
            selected_host="$2"
            shift 2
            ;;
        --confirm)
            reboot_confirmed=true
            shift
            ;;
        --timeout)
            [[ $# -ge 2 ]] || {
                printf '%s\n' 'Missing value after --timeout.' >&2
                exit 2
            }
            [[ "$2" =~ ^[0-9]+$ && $2 -ge 60 ]] || {
                printf '%s\n' 'Reboot timeout must be an integer of at least 60 seconds.' >&2
                exit 2
            }
            reboot_timeout="$2"
            shift 2
            ;;
        --preserve-postgresql-unit)
            [[ $# -ge 2 ]] || {
                printf '%s\n' 'Missing backup or restore after --preserve-postgresql-unit.' >&2
                exit 2
            }
            postgresql_unit_mode="$2"
            shift 2
            ;;
        --preserve-postgresql-unit=*)
            postgresql_unit_mode="${1#--preserve-postgresql-unit=}"
            shift
            ;;
        -F|--force|--Force)
            force_update=true
            shift
            ;;
        -sk|--ssh-key)
            [[ $# -ge 2 ]] || {
                printf '%s\n' 'Missing key path or profile after -sk/--ssh-key.' >&2
                exit 2
            }
            ssh_key="$2"
            shift 2
            ;;
        --ssh-key=*)
            ssh_key="${1#--ssh-key=}"
            shift
            ;;
        -sk=*)
            ssh_key="${1#-sk=}"
            shift
            ;;
        *)
            ansible_options+=("$1")
            shift
            ;;
    esac
done

if [[ "$repo_off_requested" == true ]]; then
    [[ "$action" == "precheck" ]] || {
        printf '%s\n' '--repo-off is valid only with the precheck command.' >&2
        exit 2
    }
    playbook="11-precheck-repo-off.yml"
fi

if [[ "$action" == "reboot" || "$action" == "update" ]]; then
    [[ -n "$selected_host" ]] || {
        printf 'The %s command requires exactly one --host HOST.\n' "$action" >&2
        exit 2
    }
    python3 "${APP_ROOT}/scripts/inventory_hostnames.py" \
        --inventory "$inventory" --contains "$selected_host" || {
        printf 'Host is not present in inventory %s: %s\n' "$environment" "$selected_host" >&2
        exit 2
    }
elif [[ -n "$selected_host" || "$reboot_confirmed" == true || "$reboot_timeout" != 900 ]]; then
    printf '%s\n' '--host, --confirm, and --timeout are valid only with reboot.' >&2
    exit 2
fi

if [[ "$action" == "update" ]]; then
    [[ "$quiet" == false ]] || {
        printf '%s\n' 'The update command is interactive and does not support -q/--quiet.' >&2
        exit 2
    }
    [[ "$reboot_confirmed" == false && "$reboot_timeout" == 900 ]] || {
        printf '%s\n' '--confirm and --timeout are valid only with reboot.' >&2
        exit 2
    }
    [[ ${#ansible_options[@]} -eq 0 ]] || {
        printf '%s\n' 'The update command does not accept additional ansible-playbook options.' >&2
        exit 2
    }
    [[ -z "$postgresql_unit_mode" || "$postgresql_unit_mode" == "backup" || "$postgresql_unit_mode" == "restore" ]] || {
        printf '%s\n' '--preserve-postgresql-unit accepts only backup or restore.' >&2
        exit 2
    }
elif [[ -n "$postgresql_unit_mode" ]]; then
    printf '%s\n' '--preserve-postgresql-unit is valid only with update.' >&2
    exit 2
fi
if [[ "$force_update" == true && "$action" != "update" ]]; then
    printf '%s\n' '-F/--force is valid only with update.' >&2
    exit 2
fi

ssh_key_options=(--key-root "$SSH_KEY_ROOT")
if [[ -n "$ssh_key" ]]; then
    ssh_key_options+=(--selector "$ssh_key")
fi
ssh_key_selector="$ssh_key"

if [[ "$action" == "reboot" && "$reboot_confirmed" == false ]]; then
    [[ -t 0 ]] || {
        printf '%s\n' 'Interactive confirmation is unavailable; use --confirm to authorize reboot.' >&2
        exit 2
    }
    printf 'WARNING: SteamRoller will reboot exactly one host: %s\n' "$selected_host"
    printf 'Type "REBOOT %s" to continue: ' "$selected_host"
    read -r reboot_answer
    [[ "$reboot_answer" == "REBOOT ${selected_host}" ]] || {
        printf '%s\n' 'Reboot cancelled.'
        exit 1
    }
fi

ssh_key="$(python3 "${APP_ROOT}/scripts/resolve_ssh_key.py" "${ssh_key_options[@]}")"
if [[ -n "$ssh_key" ]]; then
    [[ -r "$ssh_key" ]] || {
        printf 'SSH private key is not readable: %s\n' "$ssh_key" >&2
        exit 2
    }
    printf 'SSH key: %s\n' "$ssh_key"
fi

if [[ "$action" == "update" ]]; then
    [[ -t 0 && -t 1 ]] || {
        printf '%s\n' 'The update command requires an interactive terminal for the native DNF confirmation.' >&2
        exit 2
    }
    export ANSIBLE_CONFIG="$STEAMROLLER_ANSIBLE_CONFIG"
    update_command=(python3 "${APP_ROOT}/scripts/run_dnf_update.py"
        --inventory "$inventory"
        --settings "$SETTINGS_FILE"
        --environment "$environment"
        --host "$selected_host"
        --report-root "$REPORT_ROOT"
        --precheck-playbook "${APP_ROOT}/playbooks/10-precheck.yml"
        --renderer "${APP_ROOT}/scripts/render_summary.py")
    if [[ -r "$environment_settings" ]]; then
        update_command+=(--environment-settings "$environment_settings")
    fi
    if [[ -n "$ssh_key" ]]; then
        update_command+=(--ssh-key "$ssh_key")
    fi
    if [[ -n "$ssh_key_selector" ]]; then
        update_command+=(--ssh-key-selector "$ssh_key_selector")
    fi
    if [[ -n "$postgresql_unit_mode" ]]; then
        update_command+=(--postgresql-unit-mode "$postgresql_unit_mode")
    fi
    if [[ "$force_update" == true ]]; then
        update_command+=(--force)
    fi
    exec "${update_command[@]}"
fi

run_id="$(date -u +%Y%m%dT%H%M%SZ)"
output_log="$(mktemp "/tmp/steamroller-${action}.XXXXXX")"
trap 'rm -f "$output_log"' EXIT

export ANSIBLE_CONFIG="$STEAMROLLER_ANSIBLE_CONFIG"
ansible_command=(ansible-playbook
    -i "$inventory" \
    "${APP_ROOT}/playbooks/${playbook}" \
    -e "@${SETTINGS_FILE}")
if [[ -r "$environment_settings" ]]; then
    ansible_command+=(-e "@${environment_settings}")
fi
ansible_command+=(
    -e "steamroller_report_root=${REPORT_ROOT}"
    -e "steamroller_run_id=${run_id}")
if [[ "$repo_off_requested" == true ]]; then
    ansible_command+=(-e "steamroller_repo_off_requested=true")
fi
if [[ "$action" == "reboot" ]]; then
    ansible_command+=(--limit "$selected_host" -e "steamroller_reboot_timeout=${reboot_timeout}")
fi
if [[ -n "$ssh_key" ]]; then
    ansible_command+=(--private-key "$ssh_key")
fi
ansible_command+=("${ansible_options[@]}")

set +o errexit
if [[ "$quiet" == true ]]; then
    "${ansible_command[@]}" >"$output_log" 2>&1
    ansible_rc=$?
else
    "${ansible_command[@]}" 2>&1 | tee "$output_log"
    ansible_rc=${PIPESTATUS[0]}
fi
set -o errexit

render_rc=0
render_options=(
    --report-root "$REPORT_ROOT"
    --run-id "$run_id"
    --inventory "$inventory"
    --environment "$environment")
if [[ "$action" == "reboot" ]]; then
    render_options+=(--expected-host "$selected_host")
fi
python3 "${APP_ROOT}/scripts/render_summary.py" "${render_options[@]}" || render_rc=$?

if [[ $ansible_rc -ne 0 ]]; then
    printf '\nANSIBLE EXECUTION ERRORS\n' >&2
    grep -E 'fatal:|UNREACHABLE!|FAILED!|unreachable=[1-9]|failed=[1-9]' "$output_log" >&2 || true
    exit "$ansible_rc"
fi
exit "$render_rc"
